<label class="block text-sm font-medium text-slate-700"><%= t('checkout.name') %></label>
<input name="customerName" required value="<%= user && user.role === 'customer' ? user.name : '' %>" class="rounded-xl border border-slate-200 px-4 py-3" />
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.email') %></label>
  <input name="customerEmail" type="email" required value="<%= user && user.role === 'customer' ? user.email : '' %>" placeholder="nama@email.com" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
  <p data-error="email" class="mt-1 hidden text-sm text-red-600"></p>
</div>
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.whatsapp') %></label>
  <input name="customerPhone" required inputmode="tel" value="<%= user && user.phone ? user.phone : '' %>" placeholder="<%= t('checkout.whatsappHint') %>" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
  <p data-error="phone" class="mt-1 hidden text-sm text-red-600"></p>
</div>
<div class="sm:col-span-2">
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.zone') %></label>
  <select name="zone" required class="w-full rounded-xl border border-slate-200 px-4 py-3">
    <option value=""><%= t('checkout.zonePlaceholder') %></option>
    <% const zoneChoices = [
      { zone: "zona_1", label: "Zona 1 (Dekat)" },
      { zone: "zona_2", label: "Zona 2 (Ubud/Canggu)" },
      { zone: "zona_3", label: "Zona 3 (Kintamani/Singaraja)" },
    ]; %>
    <% zoneChoices.forEach((item) => {
      const priceOf = (service) => {
        const row = (zoneTariffs || []).find((tariff) => tariff.service === service && tariff.zone === item.zone);
        return row ? row.price : 0;
      };
    %>
      <option value="<%= item.zone %>" data-airport="<%= priceOf('airport') %>" data-rental="<%= priceOf('rental') %>" data-antar="<%= priceOf('antar_jemput') %>"><%= item.label %></option>
    <% }) %>
  </select>
</div>
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.pickupDate') %></label>
  <input name="pickupDate" type="date" required value="<%= typeof pickupDate !== 'undefined' ? pickupDate : '' %>" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
</div>
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.pickupTime') %></label>
  <input name="pickupTime" type="time" required value="08:00" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
</div>
<div data-pickup-text>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.pickup') %></label>
  <input name="pickupLocation" required placeholder="Contoh: Hotel di Seminyak" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
</div>
<div data-pickup-airport class="hidden">
  <label class="mb-1 block text-sm font-medium text-slate-700">Titik penjemputan</label>
  <select name="pickupLocation" data-pickup-select disabled class="w-full rounded-xl border border-slate-200 px-4 py-3">
    <option value="">Pilih titik penjemputan</option>
    <option value="Bandara / Airport">Bandara / Airport</option>
    <option value="Hotel">Hotel</option>
    <option value="Villa">Villa</option>
    <option value="Lokasi lain">Lokasi lain</option>
  </select>
</div>
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.dropoff') %></label>
  <input name="dropoffLocation" required placeholder="Contoh: Hotel di Seminyak" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
</div>
<div data-flight class="hidden sm:col-span-2">
  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.flight') %></label>
      <input name="flightNumber" data-flight-number disabled placeholder="Contoh: GA401 (opsional)" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
    </div>
    <div>
      <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.flightFile') %></label>
      <input name="referenceImage" data-flight-file type="file" accept="image/jpeg,image/png" disabled class="w-full text-sm" />
      <p data-error="flight-file" class="mt-1 hidden text-sm text-red-600"></p>
    </div>
  </div>
</div>
<div>
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.payment') %></label>
  <select name="paymentMethod" required class="w-full rounded-xl border border-slate-200 px-4 py-3">
    <option value=""><%= t('checkout.paymentPlaceholder') %></option>
    <% (paymentMethods || []).forEach((method) => { %>
      <option value="<%= method.name %>" data-type="<%= method.type %>" data-barcode="<%= method.barcodeUrl %>" data-note="<%= method.note %>"><%= method.name %></option>
    <% }) %>
  </select>
</div>
<div data-qris class="hidden rounded-xl border border-emerald-100 bg-emerald-50 p-4 text-sm sm:col-span-2">
  <p class="font-semibold text-emerald-900">QRIS</p>
  <img data-qris-image alt="QRIS" class="mt-3 hidden max-h-48 rounded border border-white bg-white" />
  <p data-qris-note class="mt-2 text-slate-600"></p>
</div>
<div data-ewallet class="hidden rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm sm:col-span-2">
  <p class="font-semibold text-amber-900">E-Wallet</p>
  <p data-ewallet-note class="mt-2 text-slate-700"></p>
</div>
<div data-banks class="hidden rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm sm:col-span-2">
  <p class="font-semibold text-sky-900">Transfer ke rekening berikut</p>
  <% if (!bankAccounts || !bankAccounts.length) { %>
    <p class="mt-2 text-slate-600">Belum ada rekening bank. Pilih QRIS atau hubungi admin.</p>
  <% } else { %>
    <ul class="mt-3 space-y-2">
      <% bankAccounts.forEach((account) => { %>
        <li class="rounded-lg bg-white px-3 py-2">
          <p class="font-semibold text-slate-900"><%= account.nama_bank %></p>
          <p class="font-mono tracking-wide text-slate-800"><%= account.nomor_rekening %></p>
          <p class="text-slate-500">a.n. <%= account.atas_nama %></p>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<div class="sm:col-span-2">
  <label class="mb-1 block text-sm font-medium text-slate-700"><%= t('checkout.special') %></label>
  <textarea name="specialRequest" rows="3" placeholder="Contoh: kursi bayi, jemput di villa, itinerary khusus" class="w-full rounded-xl border border-slate-200 px-4 py-3"></textarea>
</div>
<div data-generic-wrap class="sm:col-span-2">
  <label class="mb-1 block text-sm font-medium text-slate-700">Foto referensi voucher (opsional, JPG/PNG, maks. 2MB)</label>
  <input name="referenceImage" data-generic-file type="file" accept="image/jpeg,image/png" class="w-full text-sm" />
  <p data-error="file" class="mt-1 hidden text-sm text-red-600"></p>
</div>
<div data-driver class="hidden space-y-3 rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700 sm:col-span-2" data-driver-fee="<%= driverDailyFee %>" data-mult-zona_1="<%= areaMultiplier.zona_1 %>" data-mult-zona_2="<%= areaMultiplier.zona_2 %>" data-mult-zona_3="<%= areaMultiplier.zona_3 %>">
  <p class="font-semibold text-sky-900">Paket sopir</p>
  <p>Sewa dengan sopir dibatasi 10 jam. Lewat dari itu, overtime per jam sebesar 10% dari tarif harian dihitung saat pengembalian. Jasa sopir <%= rupiah(driverDailyFee) %> per hari.</p>
  <label class="flex items-center gap-2"><input type="radio" name="driverPackage" value="reguler" data-driver-package /> Reguler (Sopir Saja)</label>
  <label class="flex items-center gap-2"><input type="radio" name="driverPackage" value="all-in" data-driver-package /> All-In (Bebas Ribet)</label>
  <div data-allin class="hidden space-y-2 rounded-xl bg-white p-3">
    <p class="font-medium text-slate-900">Komponen All-In opsional</p>
    <% (driverAddons || []).forEach((addon) => { %>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="driverAddons" value="<%= addon.key %>" data-addon data-price="<%= addon.price %>" />
        <%= addon.label %> (<%= rupiah(addon.price) %> sebelum pengali zona)
      </label>
    <% }) %>
  </div>
  <div class="space-y-2 rounded-xl bg-white p-3 text-slate-700">
    <p><%= t('terms.reguler') %></p>
    <p><%= t('terms.allin') %></p>
  </div>
</div>
<div data-late class="hidden sm:col-span-2">
  <label class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-slate-700">
    <input data-late-check name="latePolicyAccepted" type="checkbox" class="mt-1" />
    <span><%= t('terms.late') %></span>
  </label>
</div>
<div data-lepas-kunci class="hidden space-y-4 rounded-xl border border-blue-200 bg-blue-50 p-4 text-sm sm:col-span-2">
  <p class="font-semibold text-blue-900">Dokumen Identitas (Wajib untuk Lepas Kunci)</p>
  <div>
    <label class="mb-1 block text-sm font-medium text-slate-700">Nomor SIM <span class="text-red-500">*</span></label>
    <input name="simNumber" data-sim-number type="text" required placeholder="Masukkan nomor SIM Anda" class="w-full rounded-xl border border-slate-200 px-4 py-3" />
    <p data-error="sim-number" class="mt-1 hidden text-sm text-red-600"></p>
  </div>
  <div>
    <label class="mb-1 block text-sm font-medium text-slate-700">Jenis Dokumen Identitas <span class="text-red-500">*</span></label>
    <select name="idDocumentType" data-id-document-type required class="w-full rounded-xl border border-slate-200 px-4 py-3">
      <option value="">Pilih jenis dokumen</option>
      <option value="sim">Foto SIM Aktif</option>
      <option value="ktp">Foto KTP / NIK (Untuk WNI)</option>
      <option value="passport">Foto Paspor (Untuk WNA)</option>
    </select>
    <p data-error="id-document-type" class="mt-1 hidden text-sm text-red-600"></p>
  </div>
  <div>
    <label class="mb-1 block text-sm font-medium text-slate-700">Unggah Dokumen Identitas <span class="text-red-500">*</span></label>
    <input name="idDocumentImage" data-id-document-image type="file" accept="image/jpeg,image/png" required class="w-full text-sm" />
    <p class="mt-1 text-xs text-slate-500">Format: JPG/PNG, maks. 2MB</p>
    <p data-error="id-document-image" class="mt-1 hidden text-sm text-red-600"></p>
  </div>
</div>
<label class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-slate-700 sm:col-span-2">
  <input name="termsAccepted" type="checkbox" required class="mt-1" />
  <span><%= t('checkout.terms') %></span>
</label>
<p class="text-sm text-slate-500 sm:col-span-2">Perkiraan total: <strong data-total class="text-slate-900">Pilih zona untuk melihat total</strong></p>
<button data-submit disabled class="rounded-xl bg-orange-500 py-3 font-semibold text-white enabled:hover:bg-orange-600 disabled:cursor-not-allowed disabled:bg-slate-300 sm:col-span-2"><%= submitLabel %></button>
