<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/katalog" class="brand-logo flex items-center gap-2">
      <%- include('logo') %>
      <span class="text-lg font-semibold text-brand-700"><%= typeof brand !== 'undefined' ? brand : 'Jalanin Rent Car & Tour Service' %></span>
    </a>
    <nav class="flex items-center gap-5 text-sm">
      <a href="/katalog" class="<%= typeof page !== 'undefined' && page === 'catalog' ? 'font-semibold text-brand-700' : 'text-slate-600 hover:text-brand-700' %>">Sewa Mobil</a>
      <a href="/pesanan" class="<%= typeof page !== 'undefined' && page === 'bookings' ? 'font-semibold text-brand-700' : 'text-slate-600 hover:text-brand-700' %>">Pesanan Saya</a>
      <span class="hidden text-slate-400 sm:inline"><%= user.name %></span>
      <form action="/logout" method="post">
        <button class="rounded-full border border-slate-200 px-3 py-1.5 text-slate-600 hover:bg-slate-50">Keluar</button>
      </form>
    </nav>
  </div>
</header>
