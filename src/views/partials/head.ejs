<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'id' %>" data-phone-error="<%= typeof t === 'function' ? t('error.phone') : '' %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> · <%= typeof brand !== 'undefined' ? brand : 'Jalanin Rent Car & Tour Service' %></title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: "#e8fbf8",
                100: "#c5f3ec",
                500: "#0194a7",
                600: "#007e8a",
                700: "#006874",
                900: "#0a3d44",
              },
            },
            animation: {
              "gradient-move": "gradientMove 16s ease infinite",
            },
            keyframes: {
              gradientMove: {
                "0%, 100%": { backgroundPosition: "0% 50%" },
                "50%": { backgroundPosition: "100% 50%" },
              },
            },
          },
        },
      };
    </script>
    <style>
      .brand-logo .logo-arrow,
      .brand-logo .logo-wheel,
      .brand-logo .logo-road {
        transition: transform 0.45s ease;
        transform-box: fill-box;
        transform-origin: center;
      }
      .brand-logo:hover .logo-arrow { transform: translateX(2px); }
      .brand-logo:hover .logo-wheel { transform: rotate(28deg); }
      .brand-logo:hover .logo-road { transform: translateY(-1px); }
      .review-marquee { overflow: hidden; }
      .review-track {
        display: flex;
        width: max-content;
        animation: reviewMarquee 36s linear infinite;
      }
      .review-marquee:hover .review-track { animation-play-state: paused; }
      @keyframes reviewMarquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }
      .animated-gradient {
        background-image: linear-gradient(
          -45deg,
          #062a30,
          #006874,
          #0194a7,
          #f59e0b,
          #0a3d44
        );
        background-size: 400% 400%;
        animation: gradientMove 16s ease infinite;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
<%- include('back-to-top') %>
