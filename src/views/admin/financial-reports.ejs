<%- include('../partials/head') %>
<div class="flex min-h-screen">
  <%- include('../partials/admin-sidebar', { page: 'financial-reports' }) %>
  <main class="min-w-0 flex-1 overflow-x-auto">
    <%- include('../partials/breadcrumb') %>
    <div class="p-8">
    <h1 class="text-2xl font-semibold text-slate-900">Laporan Keuangan Lengkap</h1>
    <p class="mt-1 text-slate-500">Sistem keuangan perusahaan dengan laporan laba rugi, neraca, dan arus kas</p>
    <%- include('../partials/flash') %>

    <!-- Period Filter -->
    <div class="mt-6 rounded-2xl bg-white p-4 shadow-sm">
      <div class="flex flex-wrap gap-4 items-center">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Periode</label>
          <select id="periodFilter" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <option value="month">Bulan Ini</option>
            <option value="quarter">Kuartal Ini</option>
            <option value="year">Tahun Ini</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div id="customDateRange" class="hidden flex gap-2">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Dari</label>
            <input type="date" id="startDate" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Sampai</label>
            <input type="date" id="endDate" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
          </div>
        </div>
        <div class="ml-auto">
          <button onclick="exportReport()" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">
            Export Laporan
          </button>
        </div>
      </div>
    </div>

    <!-- Summary Cards -->
    <section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-2xl bg-white p-5 shadow-sm border-l-4 border-emerald-500">
        <p class="text-sm text-slate-500">Total Pendapatan</p>
        <p class="mt-2 text-2xl font-semibold text-emerald-700"><%= rupiah(totalRevenue) %></p>
        <p class="mt-1 text-xs text-slate-400">Pendapatan bersih</p>
      </article>
      <article class="rounded-2xl bg-white p-5 shadow-sm border-l-4 border-rose-500">
        <p class="text-sm text-slate-500">Total Pengeluaran</p>
        <p class="mt-2 text-2xl font-semibold text-rose-700"><%= rupiah(totalExpenses) %></p>
        <p class="mt-1 text-xs text-slate-400">Semua kategori</p>
      </article>
      <article class="rounded-2xl bg-white p-5 shadow-sm border-l-4 border-blue-500">
        <p class="text-sm text-slate-500">Laba Bersih</p>
        <p class="mt-2 text-2xl font-semibold text-blue-700"><%= rupiah(netProfit) %></p>
        <p class="mt-1 text-xs text-slate-400">Profitabilitas</p>
      </article>
      <article class="rounded-2xl bg-white p-5 shadow-sm border-l-4 border-purple-500">
        <p class="text-sm text-slate-500">Cash Flow</p>
        <p class="mt-2 text-2xl font-semibold text-purple-700"><%= rupiah(cashFlow) %></p>
        <p class="mt-1 text-xs text-slate-400">Arus kas bersih</p>
      </article>
    </section>

    <!-- Income Statement (Laba Rugi) -->
    <div class="mt-6 rounded-2xl bg-white shadow-sm">
      <div class="p-4 border-b border-slate-200 flex justify-between items-center">
        <h2 class="font-semibold text-slate-900">Laporan Laba Rugi</h2>
        <span class="text-sm text-slate-500">Periode: <%= periodLabel %></span>
      </div>
      <div class="p-4">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="px-4 py-2 text-left">Kategori</th>
              <th class="px-4 py-2 text-right">Jumlah</th>
              <th class="px-4 py-2 text-right">% dari Total</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-100 bg-emerald-50">
              <td class="px-4 py-3 font-semibold text-emerald-900">PENDAPATAN</td>
              <td></td>
              <td></td>
            </tr>
            <% incomeItems.forEach(item => { %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2 pl-8"><%= item.label %></td>
              <td class="px-4 py-2 text-right"><%= rupiah(item.amount) %></td>
              <td class="px-4 py-2 text-right"><%= item.percentage %>%</td>
            </tr>
            <% }) %>
            <tr class="border-t-2 border-slate-200 bg-emerald-100">
              <td class="px-4 py-3 font-bold text-emerald-900">Total Pendapatan</td>
              <td class="px-4 py-3 text-right font-bold text-emerald-900"><%= rupiah(totalRevenue) %></td>
              <td class="px-4 py-3 text-right font-bold text-emerald-900">100%</td>
            </tr>
            <tr class="border-t border-slate-100 bg-rose-50">
              <td class="px-4 py-3 font-semibold text-rose-900">PENGELUARAN</td>
              <td></td>
              <td></td>
            </tr>
            <% expenseItems.forEach(item => { %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2 pl-8"><%= item.label %></td>
              <td class="px-4 py-2 text-right"><%= rupiah(item.amount) %></td>
              <td class="px-4 py-2 text-right"><%= item.percentage %>%</td>
            </tr>
            <% }) %>
            <tr class="border-t-2 border-slate-200 bg-rose-100">
              <td class="px-4 py-3 font-bold text-rose-900">Total Pengeluaran</td>
              <td class="px-4 py-3 text-right font-bold text-rose-900"><%= rupiah(totalExpenses) %></td>
              <td class="px-4 py-3 text-right font-bold text-rose-900">100%</td>
            </tr>
            <tr class="border-t-2 border-slate-300 bg-blue-100">
              <td class="px-4 py-3 font-bold text-blue-900">LABA BERSIH</td>
              <td class="px-4 py-3 text-right font-bold text-blue-900"><%= rupiah(netProfit) %></td>
              <td class="px-4 py-3 text-right font-bold text-blue-900"><%= profitMargin %>%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Balance Sheet (Neraca) -->
    <div class="mt-6 rounded-2xl bg-white shadow-sm">
      <div class="p-4 border-b border-slate-200">
        <h2 class="font-semibold text-slate-900">Neraca (Balance Sheet)</h2>
      </div>
      <div class="p-4 grid md:grid-cols-2 gap-6">
        <!-- Assets -->
        <div>
          <h3 class="font-semibold text-emerald-900 mb-3 bg-emerald-50 px-3 py-2 rounded-lg">ASET</h3>
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Kas & Setara Kas</td>
                <td class="px-3 py-2 text-right"><%= rupiah(cashAndEquivalents) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Piutang Usaha</td>
                <td class="px-3 py-2 text-right"><%= rupiah(accountsReceivable) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Persediaan</td>
                <td class="px-3 py-2 text-right"><%= rupiah(inventory) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Aset Tetap</td>
                <td class="px-3 py-2 text-right"><%= rupiah(fixedAssets) %></td>
              </tr>
              <tr class="border-t-2 border-emerald-200 bg-emerald-100">
                <td class="px-3 py-2 font-bold text-emerald-900">Total Aset</td>
                <td class="px-3 py-2 text-right font-bold text-emerald-900"><%= rupiah(totalAssets) %></td>
              </tr>
            </tbody>
          </table>
        </div>
        <!-- Liabilities & Equity -->
        <div>
          <h3 class="font-semibold text-rose-900 mb-3 bg-rose-50 px-3 py-2 rounded-lg">KEWAJIBAN & EKUITAS</h3>
          <table class="w-full text-sm">
            <tbody>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Utang Usaha</td>
                <td class="px-3 py-2 text-right"><%= rupiah(accountsPayable) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Utang Gaji</td>
                <td class="px-3 py-2 text-right"><%= rupiah(payrollPayable) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Laba Ditahan</td>
                <td class="px-3 py-2 text-right"><%= rupiah(retainedEarnings) %></td>
              </tr>
              <tr class="border-t border-slate-100">
                <td class="px-3 py-2">Modal Saham</td>
                <td class="px-3 py-2 text-right"><%= rupiah(ownerEquity) %></td>
              </tr>
              <tr class="border-t-2 border-rose-200 bg-rose-100">
                <td class="px-3 py-2 font-bold text-rose-900">Total Kewajiban & Ekuitas</td>
                <td class="px-3 py-2 text-right font-bold text-rose-900"><%= rupiah(totalLiabilitiesAndEquity) %></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Cash Flow Statement -->
    <div class="mt-6 rounded-2xl bg-white shadow-sm">
      <div class="p-4 border-b border-slate-200">
        <h2 class="font-semibold text-slate-900">Laporan Arus Kas (Cash Flow)</h2>
      </div>
      <div class="p-4">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="px-4 py-2 text-left">Kategori</th>
              <th class="px-4 py-2 text-right">Masuk</th>
              <th class="px-4 py-2 text-right">Keluar</th>
              <th class="px-4 py-2 text-right">Net</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-100 bg-emerald-50">
              <td class="px-4 py-3 font-semibold text-emerald-900">ARUS KAS DARI OPERASI</td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
            <% operatingCashFlow.forEach(item => { %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2 pl-8"><%= item.label %></td>
              <td class="px-4 py-2 text-right text-emerald-600"><%= item.in ? rupiah(item.in) : '-' %></td>
              <td class="px-4 py-2 text-right text-rose-600"><%= item.out ? rupiah(item.out) : '-' %></td>
              <td class="px-4 py-2 text-right font-semibold <%= item.net >= 0 ? 'text-emerald-600' : 'text-rose-600' %>"><%= rupiah(item.net) %></td>
            </tr>
            <% }) %>
            <tr class="border-t-2 border-slate-200 bg-emerald-100">
              <td class="px-4 py-3 font-bold text-emerald-900">Net Operating Cash Flow</td>
              <td class="px-4 py-3 text-right font-bold text-emerald-900"><%= rupiah(totalOperatingIn) %></td>
              <td class="px-4 py-3 text-right font-bold text-emerald-900"><%= rupiah(totalOperatingOut) %></td>
              <td class="px-4 py-3 text-right font-bold text-emerald-900"><%= rupiah(netOperatingCash) %></td>
            </tr>
            <tr class="border-t border-slate-100 bg-blue-50">
              <td class="px-4 py-3 font-semibold text-blue-900">ARUS KAS DARI INVESTASI</td>
              <td></td>
              <td></td>
              <td></td>
            </tr>
            <% investingCashFlow.forEach(item => { %>
            <tr class="border-t border-slate-100">
              <td class="px-4 py-2 pl-8"><%= item.label %></td>
              <td class="px-4 py-2 text-right text-emerald-600"><%= item.in ? rupiah(item.in) : '-' %></td>
              <td class="px-4 py-2 text-right text-rose-600"><%= item.out ? rupiah(item.out) : '-' %></td>
              <td class="px-4 py-2 text-right font-semibold <%= item.net >= 0 ? 'text-emerald-600' : 'text-rose-600' %>"><%= rupiah(item.net) %></td>
            </tr>
            <% }) %>
            <tr class="border-t-2 border-slate-200 bg-blue-100">
              <td class="px-4 py-3 font-bold text-blue-900">Net Investing Cash Flow</td>
              <td class="px-4 py-3 text-right font-bold text-blue-900"><%= rupiah(totalInvestingIn) %></td>
              <td class="px-4 py-3 text-right font-bold text-blue-900"><%= rupiah(totalInvestingOut) %></td>
              <td class="px-4 py-3 text-right font-bold text-blue-900"><%= rupiah(netInvestingCash) %></td>
            </tr>
            <tr class="border-t-2 border-slate-300 bg-purple-100">
              <td class="px-4 py-3 font-bold text-purple-900">NET CASH FLOW</td>
              <td class="px-4 py-3 text-right font-bold text-purple-900"><%= rupiah(totalCashIn) %></td>
              <td class="px-4 py-3 text-right font-bold text-purple-900"><%= rupiah(totalCashOut) %></td>
              <td class="px-4 py-3 text-right font-bold text-purple-900"><%= rupiah(cashFlow) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    </div>
  </main>
</div>

<script>
document.getElementById('periodFilter').addEventListener('change', function() {
  const customRange = document.getElementById('customDateRange');
  if (this.value === 'custom') {
    customRange.classList.remove('hidden');
  } else {
    customRange.classList.add('hidden');
  }
});

function exportReport() {
  alert('Fitur export akan tersedia setelah integrasi dengan library PDF/Excel');
}
</script>
</body>
</html>
