<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Serah Terima Lepas Kunci - Booking #<%= booking.id %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Header -->
  <header class="bg-emerald-600 text-white py-4 px-4 shadow-lg">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold">Serah Terima Lepas Kunci</h1>
          <p class="text-emerald-100 text-sm">Booking #<%= booking.id %></p>
        </div>
        <div class="text-right">
          <p class="text-sm text-emerald-100">Status</p>
          <p class="font-semibold"><%= booking.status %></p>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto p-4 space-y-4">
    <!-- Verifikasi Form -->
    <div id="verification-section" class="bg-white rounded-2xl shadow-md p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Verifikasi Identitas Staf</h2>
      <form id="verify-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Staf</label>
          <input type="text" id="staffName" name="staffName" required 
                 class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                 placeholder="Masukkan nama Anda">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Kode Booking</label>
          <input type="text" id="bookingCode" name="bookingCode" required 
                 class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
                 placeholder="Masukkan kode booking">
        </div>
        <button type="submit" 
                class="w-full bg-emerald-600 text-white py-3 rounded-xl font-semibold hover:bg-emerald-700 transition-colors">
          Verifikasi & Lanjut
        </button>
      </form>
      <div id="error-message" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>
    </div>

    <!-- Booking Details & Upload (Hidden until verified) -->
    <div id="upload-section" class="hidden space-y-4">
      <!-- Vehicle Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">🚗</span>
          Informasi Kendaraan
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Nama Kendaraan</span>
            <span class="font-semibold text-gray-900"><%= booking.details.vehicleName %></span>
          </div>
          <% if (vehicle) { %>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Plat Nomor</span>
            <span class="font-semibold text-gray-900"><%= vehicle.plateNumber || 'N/A' %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tipe</span>
            <span class="font-semibold text-gray-900"><%= vehicle.type %></span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Kursi</span>
            <span class="font-semibold text-gray-900"><%= vehicle.seats %> Kursi</span>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Schedule Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📅</span>
          Jadwal Sewa
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tanggal Mulai</span>
            <span class="font-semibold text-gray-900"><%= booking.details.pickupDate %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tanggal Selesai</span>
            <span class="font-semibold text-gray-900"><%= endDate %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Jam Jemput</span>
            <span class="font-semibold text-gray-900"><%= booking.details.pickupTime %></span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Durasi</span>
            <span class="font-semibold text-gray-900"><%= booking.details.durationDays %> Hari</span>
          </div>
        </div>
      </div>

      <!-- Customer Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">👤</span>
          Informasi Penyewa
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Nama</span>
            <span class="font-semibold text-gray-900"><%= booking.customerName %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Nomor HP</span>
            <a href="tel:<%= booking.customerPhone %>" 
               class="font-semibold text-emerald-600 hover:text-emerald-800">
              <%= booking.customerPhone %>
            </a>
          </div>
          <% if (booking.details.simNumber) { %>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Nomor SIM</span>
            <span class="font-semibold text-gray-900"><%= booking.details.simNumber %></span>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Upload Identity Photo -->
      <div class="bg-blue-50 rounded-2xl shadow-md p-6 border border-blue-200">
        <h2 class="text-lg font-bold text-blue-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📷</span>
          Upload Identitas Penyewa
        </h2>
        <p class="text-blue-800 text-sm mb-4">Ambil foto penyewa saat memegang KTP/Paspor asli untuk verifikasi identitas.</p>
        
        <form id="identity-upload-form" class="space-y-4">
          <input type="hidden" id="staffNameHidden" name="staffName" value="">
          <div>
            <label class="block text-sm font-medium text-blue-900 mb-2">Foto Identitas Penyewa (KTP/Paspor)</label>
            <input type="file" id="identityPhoto" name="identityPhoto" accept="image/*" capture="environment"
                   class="w-full text-sm text-blue-800 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700">
            <p class="mt-2 text-xs text-blue-700">Format: JPG/PNG, maks. 2MB</p>
          </div>
          <button type="submit" 
                  class="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition-colors">
            Upload Foto Identitas
          </button>
        </form>
        <div id="identity-success" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm">
          <p class="font-semibold">✓ Foto identitas berhasil diunggah</p>
        </div>
        <div id="identity-error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>
      </div>

      <!-- Upload Car Condition Photos -->
      <div class="bg-orange-50 rounded-2xl shadow-md p-6 border border-orange-200">
        <h2 class="text-lg font-bold text-orange-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">🚙</span>
          Upload Kondisi Mobil
        </h2>
        <p class="text-orange-800 text-sm mb-4">Ambil foto keliling mobil untuk dokumentasi kondisi awal (lecet, goresan, dll).</p>
        
        <form id="car-condition-upload-form" class="space-y-4">
          <input type="hidden" id="staffNameHidden2" name="staffName" value="">
          <div>
            <label class="block text-sm font-medium text-orange-900 mb-2">Foto Kondisi Mobil (Maks. 10 foto)</label>
            <input type="file" id="carConditionPhotos" name="carConditionPhotos" accept="image/*" multiple capture="environment"
                   class="w-full text-sm text-orange-800 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-orange-600 file:text-white hover:file:bg-orange-700">
            <p class="mt-2 text-xs text-orange-700">Format: JPG/PNG, maks. 2MB per foto</p>
          </div>
          <button type="submit" 
                  class="w-full bg-orange-600 text-white py-3 rounded-xl font-semibold hover:bg-orange-700 transition-colors">
            Upload Foto Kondisi Mobil
          </button>
        </form>
        <div id="car-condition-success" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm">
          <p class="font-semibold">✓ Foto kondisi mobil berhasil diunggah</p>
        </div>
        <div id="car-condition-error" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>
      </div>

      <!-- View Uploaded Photos -->
      <div id="uploaded-photos-section" class="hidden bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">🖼️</span>
          Foto yang Telah Diunggah
        </h2>
        
        <div id="identity-photo-preview" class="hidden mb-6">
          <h3 class="font-semibold text-gray-900 mb-2">Foto Identitas Penyewa</h3>
          <img id="identity-photo-img" src="" alt="Foto Identitas" class="max-w-full h-auto rounded-xl border border-gray-200">
        </div>
        
        <div id="car-condition-photos-preview" class="hidden">
          <h3 class="font-semibold text-gray-900 mb-2">Foto Kondisi Mobil</h3>
          <div id="car-condition-photos-grid" class="grid grid-cols-2 md:grid-cols-3 gap-4"></div>
        </div>
      </div>

      <!-- Contact Admin -->
      <div class="bg-gray-50 rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📞</span>
          Butuh Bantuan?
        </h2>
        <p class="text-gray-600 text-sm mb-3">Hubungi admin jika ada pertanyaan atau kendala:</p>
        <a href="https://wa.me/6282266490281" target="_blank" 
           class="inline-flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-xl font-semibold hover:bg-green-700 transition-colors">
          <span>WhatsApp Admin</span>
        </a>
      </div>
    </div>
  </main>

  <script>
    const staffNameInput = document.getElementById('staffName');
    const staffNameHidden = document.getElementById('staffNameHidden');
    const staffNameHidden2 = document.getElementById('staffNameHidden2');

    document.getElementById('verify-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const staffName = staffNameInput.value;
      const bookingCode = document.getElementById('bookingCode').value;
      const errorDiv = document.getElementById('error-message');
      
      try {
        const response = await fetch(`/check/staff-<%= booking.id %>-<%= booking.staffToken %>/verify`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ staffName, bookingCode }),
        });
        
        const result = await response.json();
        
        if (result.ok) {
          staffNameHidden.value = staffName;
          staffNameHidden2.value = staffName;
          document.getElementById('verification-section').classList.add('hidden');
          document.getElementById('upload-section').classList.remove('hidden');
        } else {
          errorDiv.textContent = result.message;
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        errorDiv.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
        errorDiv.classList.remove('hidden');
      }
    });

    document.getElementById('identity-upload-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const errorDiv = document.getElementById('identity-error');
      const successDiv = document.getElementById('identity-success');
      
      try {
        const response = await fetch(`/check/staff-<%= booking.id %>-<%= booking.staffToken %>/upload`, {
          method: 'POST',
          body: formData,
        });
        
        const result = await response.json();
        
        if (result.ok) {
          errorDiv.classList.add('hidden');
          successDiv.classList.remove('hidden');
          
          if (result.identityPhoto) {
            document.getElementById('identity-photo-img').src = result.identityPhoto;
            document.getElementById('identity-photo-preview').classList.remove('hidden');
            document.getElementById('uploaded-photos-section').classList.remove('hidden');
          }
          
          e.target.reset();
        } else {
          successDiv.classList.add('hidden');
          errorDiv.textContent = result.message;
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        successDiv.classList.add('hidden');
        errorDiv.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
        errorDiv.classList.remove('hidden');
      }
    });

    document.getElementById('car-condition-upload-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const errorDiv = document.getElementById('car-condition-error');
      const successDiv = document.getElementById('car-condition-success');
      
      try {
        const response = await fetch(`/check/staff-<%= booking.id %>-<%= booking.staffToken %>/upload`, {
          method: 'POST',
          body: formData,
        });
        
        const result = await response.json();
        
        if (result.ok) {
          errorDiv.classList.add('hidden');
          successDiv.classList.remove('hidden');
          
          if (result.carConditionPhotos && result.carConditionPhotos.length > 0) {
            const grid = document.getElementById('car-condition-photos-grid');
            grid.innerHTML = '';
            result.carConditionPhotos.forEach(photoUrl => {
              const img = document.createElement('img');
              img.src = photoUrl;
              img.alt = 'Foto Kondisi Mobil';
              img.className = 'w-full h-auto rounded-xl border border-gray-200';
              grid.appendChild(img);
            });
            document.getElementById('car-condition-photos-preview').classList.remove('hidden');
            document.getElementById('uploaded-photos-section').classList.remove('hidden');
          }
          
          e.target.reset();
        } else {
          successDiv.classList.add('hidden');
          errorDiv.textContent = result.message;
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        successDiv.classList.add('hidden');
        errorDiv.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
        errorDiv.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
