<%- include('partials/head') %>
<%- include('partials/breadcrumb') %>
<main class="min-h-screen bg-slate-100 px-3 py-8">
  <!-- Kembali Button -->
  <div class="mb-4 flex justify-end">
    <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-200 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7" />
      </svg>
      Kembali
    </a>
  </div>

  <div class="mx-auto max-w-5xl">
    <header class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-slate-900">Blog Wisata Bali</h1>
      <p class="mt-2 text-slate-600">Tips, panduan, dan inspirasi perjalanan di Bali</p>
    </header>

    <!-- Featured Article -->
    <article class="mb-8 rounded-3xl bg-white overflow-hidden shadow-lg">
      <div class="grid md:grid-cols-2">
        <div class="h-64 bg-gradient-to-br from-brand-500 to-brand-700 md:h-auto">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-24 w-24 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        <div class="p-8">
          <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">Featured</span>
          <h2 class="mt-4 text-2xl font-bold text-slate-900">10 Tempat Wisata Terbaik di Bali yang Wajib Dikunjungi</h2>
          <p class="mt-3 text-slate-600">Temukan destinasi wisata paling ikonik di Bali mulai dari pantai cantik, pura kuno, hingga sawah terasering yang memukau.</p>
          <a href="#" class="mt-4 inline-block font-semibold text-brand-700 hover:text-brand-800">Baca Selengkapnya →</a>
        </div>
      </div>
    </article>

    <!-- Blog Grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-emerald-400 to-emerald-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-emerald-600 font-semibold">Tips Perjalanan</span>
          <h3 class="mt-2 font-bold text-slate-900">Tips Menyewa Mobil di Bali untuk Wisatawan Pertama</h3>
          <p class="mt-2 text-sm text-slate-600">Panduan lengkap untuk wisatawan yang pertama kali menyewa mobil di Bali.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-emerald-700 hover:text-emerald-800">Baca →</a>
        </div>
      </article>

      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-blue-400 to-blue-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-blue-600 font-semibold">Pantai</span>
          <h3 class="mt-2 font-bold text-slate-900">5 Pantai Tersembunyi di Bali yang Belum Banyak Diketahui</h3>
          <p class="mt-2 text-sm text-slate-600">Temukan pantai-pantai indah yang masih asri dan jarang dikunjungi wisatawan.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-blue-700 hover:text-blue-800">Baca →</a>
        </div>
      </article>

      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-purple-400 to-purple-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-purple-600 font-semibold">Budaya</span>
          <h3 class="mt-2 font-bold text-slate-900">Mengenal Tradisi dan Budaya Bali yang Unik</h3>
          <p class="mt-2 text-sm text-slate-600">Pelajari tradisi, upacara adat, dan budaya unik Bali yang memikat.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-purple-700 hover:text-purple-800">Baca →</a>
        </div>
      </article>

      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-orange-400 to-orange-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-orange-600 font-semibold">Kuliner</span>
          <h3 class="mt-2 font-bold text-slate-900">7 Kuliner Khas Bali yang Wajib Dicoba</h3>
          <p class="mt-2 text-sm text-slate-600">Jangan lewatkan masakan khas Bali yang lezat dan unik ini saat berkunjung.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-orange-700 hover:text-orange-800">Baca →</a>
        </div>
      </article>

      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-rose-400 to-rose-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-rose-600 font-semibold">Budaya</span>
          <h3 class="mt-2 font-bold text-slate-900">Etika Berwisata di Bali yang Perlu Diketahui</h3>
          <p class="mt-2 text-sm text-slate-600">Pelajari etika dan sopan santun saat mengunjungi tempat suci di Bali.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-rose-700 hover:text-rose-800">Baca →</a>
        </div>
      </article>

      <article class="rounded-2xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="h-48 bg-gradient-to-br from-teal-400 to-teal-600">
          <div class="flex h-full items-center justify-center text-white">
            <svg class="h-16 w-16 opacity-50" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="p-6">
          <span class="text-xs text-teal-600 font-semibold">Tips</span>
          <h3 class="mt-2 font-bold text-slate-900">Waktu Terbaik untuk Berkunjung ke Bali</h3>
          <p class="mt-2 text-sm text-slate-600">Kapan waktu terbaik untuk liburan di Bali? Temukan jawabannya di sini.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-teal-700 hover:text-teal-800">Baca →</a>
        </div>
      </article>
    </div>

    <!-- Newsletter -->
    <div class="mt-12 rounded-2xl bg-brand-600 p-8 text-center text-white">
      <h2 class="text-2xl font-bold">Berlangganan Newsletter Kami</h2>
      <p class="mt-2 text-brand-100">Dapatkan tips wisata Bali terbaru langsung ke inbox Anda</p>
      <form class="mt-6 mx-auto flex max-w-md gap-3">
        <input type="email" placeholder="Email Anda" class="flex-1 rounded-xl px-4 py-3 text-slate-900" required>
        <button type="submit" class="rounded-xl bg-white px-6 py-3 font-semibold text-brand-700 hover:bg-brand-50">Berlangganan</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>
