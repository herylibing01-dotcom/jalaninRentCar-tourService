<%- include('partials/head') %>
<% const details = order.details || {}; %>
<%- include('partials/breadcrumb') %>
<main class="min-h-screen bg-slate-200 px-3 py-6">
  <article class="mx-auto max-w-3xl bg-white shadow-lg">
    <header class="flex items-start justify-between gap-4 border-b border-slate-200 px-6 py-5">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700"><%= t('voucher.kicker') %></p>
        <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= t('voucher.title') %></h1>
        <p class="mt-2 inline-flex items-center gap-2 rounded-full bg-sky-50 px-3 py-1 text-sm font-semibold text-sky-700">Dengan layanan <%= serviceLabel(order.serviceType) %></p>
      </div>
      <div class="text-right">
        <p class="text-lg font-bold text-sky-800">Jalanin</p>
        <p class="text-xs text-slate-500">Rent Car &amp; Tour Service</p>
        <p class="mt-2 text-xs text-slate-500">ID Pesanan #<%= order.id %></p>
      </div>
    </header>

    <section class="px-6 py-5">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('voucher.booker') %></h2>
      <table class="mt-3 w-full border-collapse text-sm">
        <thead class="bg-slate-100 text-left text-slate-600">
          <tr>
            <th class="border border-slate-200 px-3 py-2 font-medium"><%= t('voucher.name') %></th>
            <th class="border border-slate-200 px-3 py-2 font-medium"><%= t('voucher.phone') %></th>
            <th class="border border-slate-200 px-3 py-2 font-medium"><%= t('voucher.email') %></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="border border-slate-200 px-3 py-3"><%= order.customerName %></td>
            <td class="border border-slate-200 px-3 py-3"><%= order.customerPhone %></td>
            <td class="border border-slate-200 px-3 py-3"><%= order.customerEmail %></td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="px-6 pb-5">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('voucher.important') %></h2>
      <table class="mt-3 w-full border-collapse text-sm">
        <thead>
          <tr class="bg-sky-50 text-left text-sky-900">
            <th class="border border-slate-200 px-3 py-2 font-semibold">Customer</th>
            <th class="border border-slate-200 px-3 py-2 font-semibold">Penting untuk Vendor</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="border border-slate-200 px-3 py-3 align-top">Pesanan <%= brandShort %></td>
            <td class="border border-slate-200 px-3 py-3">
              <ol class="list-decimal space-y-1 pl-4">
                <li>Konfirmasi identitas sopir dan unit sebelum perjalanan.</li>
                <li>Sopir tiba 30 menit sebelum jadwal penjemputan.</li>
                <li>Kendaraan dalam kondisi bersih dan siap jalan.</li>
                <li>Pembatalan kurang dari 24 jam sebelum jemput hangus.</li>
              </ol>
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="px-6 pb-5">
      <table class="w-full border-collapse text-sm">
        <thead class="bg-slate-100 text-left text-slate-600">
          <tr>
            <th class="border border-slate-200 px-3 py-2">Tipe Sewa</th>
            <th class="border border-slate-200 px-3 py-2">Durasi</th>
            <th class="border border-slate-200 px-3 py-2">Wilayah Sewa</th>
            <th class="border border-slate-200 px-3 py-2">Tanggal Jemput</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="border border-slate-200 px-3 py-3"><%= details.rentalType || details.serviceKind || details.packageType || serviceLabel(order.serviceType) %></td>
            <td class="border border-slate-200 px-3 py-3"><%= details.durationDays ? details.durationDays + ' hari' : details.participantCount ? details.participantCount + ' peserta' : '-' %></td>
            <td class="border border-slate-200 px-3 py-3"><%= details.zoneLabel || '-' %><% if (order.paymentMethod || details.paymentMethod) { %><br><span class="text-slate-500"><%= order.paymentMethod || details.paymentMethod %></span><% } %></td>
            <td class="border border-slate-200 px-3 py-3"><%= details.pickupDate || details.landingAt || '-' %><% if (details.pickupTime) { %><br><%= details.pickupTime %><% } %></td>
          </tr>
        </tbody>
      </table>
      <% if (details.vehicleName || details.hotelLocation) { %>
        <p class="mt-3 text-sm text-slate-600">Unit / tujuan: <strong class="text-slate-900"><%= details.vehicleName || details.hotelLocation %></strong></p>
      <% } %>
      <% if (details.driverPackage) { %>
        <div class="mt-4 rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-slate-700">
          <p class="font-semibold text-slate-900">Paket <%= details.driverPackage === 'all-in' ? 'All-In (Bebas Ribet)' : 'Reguler (Sopir Saja)' %></p>
          <p class="mt-1">Jasa sopir <%= rupiah(details.driverFee || 0) %> · pengali area <%= details.areaMultiplier || 1 %>x · komponen <%= rupiah(details.allInAmount || 0) %></p>
          <% if (details.driverAddons && details.driverAddons.length) { %>
            <ul class="mt-2 list-disc pl-5">
              <% details.driverAddons.forEach((item) => { %><li><%= item.label %> — <%= rupiah(item.line) %></li><% }) %>
            </ul>
          <% } %>
          <p class="mt-2 font-semibold"><%= t('voucher.termsTitle') %></p>
          <p class="mt-2"><%= details.driverPackage === 'all-in' ? t('terms.allin') : t('terms.reguler') %></p>
        </div>
      <% } %>
      <% if (details.pickupLocation || details.dropoffLocation) { %>
        <p class="mt-2 text-sm text-slate-600">Lokasi penjemputan: <strong class="text-slate-900"><%= details.pickupLocation || '-' %></strong></p>
        <p class="mt-1 text-sm text-slate-600">Lokasi pengantaran: <strong class="text-slate-900"><%= details.dropoffLocation || '-' %></strong></p>
      <% } %>
    </section>

    <section class="px-6 pb-5">
      <h2 class="text-lg font-semibold text-slate-900">Tarif</h2>
      <table class="mt-3 w-full border-collapse text-sm">
        <thead class="bg-slate-100 text-left text-slate-600">
          <tr>
            <th class="border border-slate-200 px-3 py-2">Item</th>
            <th class="border border-slate-200 px-3 py-2">Jumlah</th>
            <th class="border border-slate-200 px-3 py-2">Harga/Durasi</th>
            <th class="border border-slate-200 px-3 py-2 text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="border border-slate-200 px-3 py-2"><%= details.vehicleName || details.packageType || details.serviceKind || 'Layanan' %></td>
            <td class="border border-slate-200 px-3 py-2"><%= details.durationDays || 1 %></td>
            <td class="border border-slate-200 px-3 py-2"><%= rupiah(details.baseAmount || 0) %></td>
            <td class="border border-slate-200 px-3 py-2 text-right"><%= rupiah(details.baseAmount || 0) %></td>
          </tr>
          <tr>
            <td class="border border-slate-200 px-3 py-2"><%= details.deliveryFee ? 'Ongkos antar-jemput' : 'Zona' %> <%= details.zoneLabel || '-' %></td>
            <td class="border border-slate-200 px-3 py-2">1</td>
            <td class="border border-slate-200 px-3 py-2"><%= rupiah(details.zoneFee || 0) %></td>
            <td class="border border-slate-200 px-3 py-2 text-right"><%= rupiah(details.zoneFee || 0) %></td>
          </tr>
          <tr>
            <td colspan="3" class="border border-slate-200 px-3 py-3 text-right font-semibold">Total</td>
            <td class="border border-slate-200 px-3 py-3 text-right font-bold"><%= rupiah(details.totalPrice || 0) %></td>
          </tr>
        </tbody>
      </table>
    </section>

    <% if (details.specialRequest || details.referenceImage) { %>
      <section class="px-6 pb-5 text-sm">
        <h2 class="text-lg font-semibold text-slate-900">Permintaan khusus</h2>
        <p class="mt-2 text-slate-700"><%= details.specialRequest || 'Tidak ada catatan.' %></p>
        <% if (details.referenceImage) { %>
          <a href="<%= details.referenceImage %>" class="mt-3 inline-block text-sky-700 underline">Lihat file referensi</a>
          <img src="<%= details.referenceImage %>" alt="Referensi pemesan" class="mt-3 max-h-48 rounded border border-slate-200" />
        <% } %>
      </section>
    <% } %>

    <section class="px-6 pb-6 text-sm text-slate-700">
      <h2 class="text-lg font-semibold text-slate-900">Syarat &amp; Ketentuan</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5">
        <li>Pembatalan kurang dari 24 jam sebelum waktu penjemputan dinyatakan hangus.</li>
        <li>Kendaraan dilindungi asuransi sesuai polis. Kerusakan akibat kelalaian penyewa menjadi tanggung jawab penyewa.</li>
        <li>Denda overtime dikenakan jika durasi sewa melewati batas waktu yang disepakati.</li>
        <li>Biaya zona luar kota Bali sebesar Rp 250.000 (operasional bensin) sudah masuk pada tarif bila zona itu dipilih.</li>
        <li>Tol, parkir, dan tiket objek wisata dibayarkan langsung selama perjalanan bila tidak termasuk paket.</li>
      </ol>
    </section>

    <section class="flex flex-wrap items-center gap-3 px-6 pb-6" data-deadline="<%= order.createdAt ? new Date(new Date(order.createdAt).getTime() + 60 * 60 * 1000).toISOString() : '' %>">
      <% if (editable) { %>
        <a data-edit-link href="/pesanan/<%= order.id %>/ubah" class="rounded-xl bg-orange-500 px-4 py-3 text-sm font-semibold text-white hover:bg-orange-600">Ubah tanggal &amp; jam penjemputan</a>
      <% } %>
      <p data-lock class="<%= editExpired ? '' : 'hidden' %> rounded-xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700">Pesanan Tidak Dapat Diubah</p>
      <a href="/" class="rounded-xl bg-sky-800 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-900">Kembali ke Beranda</a>
      
      <!-- WhatsApp Share Buttons -->
      <% if (driverTaskLink(order) && order.assignedEmployeeName) { %>
        <a href="<%= driverWhatsAppLink(order, order.assignedEmployeeName) %>" target="_blank" rel="noopener"
           class="rounded-xl bg-green-500 px-4 py-3 text-sm font-semibold text-white hover:bg-green-600">
          🟢 Bagikan ke Driver via WA
        </a>
      <% } %>
      <% if (staffCheckLink(order)) { %>
        <a href="<%= staffWhatsAppLink(order, 'Staf Lapangan') %>" target="_blank" rel="noopener"
           class="rounded-xl bg-green-500 px-4 py-3 text-sm font-semibold text-white hover:bg-green-600">
          🟢 Bagikan ke Staf via WA
        </a>
      <% } %>
    </section>

    <footer class="grid gap-4 border-t border-slate-200 bg-slate-50 px-6 py-5 text-xs text-slate-600 sm:grid-cols-2">
      <div>
        <p class="font-semibold text-sky-800"><%= brand %></p>
        <p class="mt-1"><%= company.address %></p>
        <p class="mt-2">WhatsApp <%= company.phone %></p>
        <p><%= company.email %></p>
      </div>
      <div class="sm:text-right">
        <p>ID Pesanan #<%= order.id %></p>
        <p class="mt-1">Status: <%= orderStatusLabel(order.status) %></p>
        <% if (order.assignedEmployeeName) { %><p>Sopir: <%= order.assignedEmployeeName %></p><% } %>
        <% if (driverTaskLink(order)) { %>
        <p class="mt-2">
          <a href="<%= driverTaskLink(order) %>" class="text-sky-700 hover:text-sky-900 underline">Link Tugas Driver</a>
        </p>
        <% } %>
        <% if (staffCheckLink(order)) { %>
        <p class="mt-2">
          <a href="<%= staffCheckLink(order) %>" class="text-emerald-700 hover:text-emerald-900 underline">Link Serah Terima Staf</a>
        </p>
        <% } %>
      </div>
    </footer>
  </article>
</main>
<script src="/js/edit-order.js"></script>
</body>
</html>
