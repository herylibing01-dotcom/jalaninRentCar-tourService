<%- include('partials/head') %>
<%- include('partials/breadcrumb') %>
<main class="min-h-screen bg-slate-100 px-3 py-8">
  <div class="mx-auto max-w-5xl">
    <!-- Hero Section -->
    <header class="mb-12 rounded-3xl bg-gradient-to-r from-brand-600 to-brand-800 p-8 text-center text-white md:p-12">
      <h1 class="text-4xl font-bold md:text-5xl">Tentang Jalanin Rent Car & Tour Service</h1>
      <p class="mt-4 text-xl text-brand-100">Mitra perjalanan terpercaya Anda di Bali sejak 2020</p>
    </header>

    <!-- Our Story -->
    <section class="mb-12 rounded-2xl bg-white p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">Cerita Kami</h2>
      <div class="prose max-w-none text-slate-600">
        <p class="mb-4">
          Jalanin Rent Car & Tour Service berdiri dengan visi sederhana: memberikan pengalaman perjalanan yang nyaman, aman, dan tak terlupakan di Bali. Kami memulai dari nol dengan satu mobil dan semangat untuk melayani wisatawan dengan sepenuh hati.
        </p>
        <p class="mb-4">
          Seiring berjalannya waktu, kami tumbuh menjadi penyedia layanan rental mobil dan tour yang dipercaya oleh ribuan pelanggan, baik wisatawan domestik maupun internasional. Kepercayaan Anda adalah motivasi kami untuk terus meningkatkan kualitas layanan.
        </p>
        <p>
          Kami tidak hanya menyewakan mobil, kami menyediakan pengalaman perjalanan yang lengkap dengan driver berpengalaman, kendaraan terawat, dan pelayanan yang ramah.
        </p>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="mb-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl bg-white p-8 shadow-sm">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand-100">
          <svg class="h-8 w-8 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Misi Kami</h3>
        <p class="text-slate-600">
          Menjadi penyedia layanan rental mobil dan tour terbaik di Bali dengan mengutamakan kepuasan pelanggan, keamanan, dan kenyamanan dalam setiap perjalanan.
        </p>
      </div>
      <div class="rounded-2xl bg-white p-8 shadow-sm">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand-100">
          <svg class="h-8 w-8 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">Visi Kami</h3>
        <p class="text-slate-600">
          Menjadi pilihan utama wisatawan dalam menikmati keindahan Bali dengan layanan profesional, armada berkualitas, dan pengalaman yang tak terlupakan.
        </p>
      </div>
    </section>

    <!-- Why Choose Us -->
    <section class="mb-12 rounded-2xl bg-white p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 text-center">Mengapa Memilih Kami?</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
            <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Armada Terawat</h3>
          <p class="text-sm text-slate-600">Semua kendaraan dalam kondisi prima dan terawat rutin</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-blue-100">
            <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Driver Berpengalaman</h3>
          <p class="text-sm text-slate-600">Driver ramah, berpengalaman, dan mengenal rute Bali</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-purple-100">
            <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Harga Kompetitif</h3>
          <p class="text-sm text-slate-600">Harga transparan tanpa biaya tersembunyi</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-orange-100">
            <svg class="h-8 w-8 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">24/7 Support</h3>
          <p class="text-sm text-slate-600">Layanan pelanggan siap membantu kapan saja</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-rose-100">
            <svg class="h-8 w-8 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Asuransi Lengkap</h3>
          <p class="text-sm text-slate-600">Kendaraan dilindungi asuransi all-risk</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-teal-100">
            <svg class="h-8 w-8 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-slate-900 mb-2">Layanan dengan Hati</h3>
          <p class="text-sm text-slate-600">Kami melayani dengan sepenuh hati seperti keluarga</p>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="mb-12 rounded-2xl bg-gradient-to-r from-brand-600 to-brand-800 p-8 text-white">
      <h2 class="text-2xl font-bold mb-6 text-center">Angka yang Bicara</h2>
      <div class="grid gap-6 text-center md:grid-cols-4">
        <div>
          <p class="text-4xl font-bold">5000+</p>
          <p class="mt-2 text-brand-100">Pelanggan Puas</p>
        </div>
        <div>
          <p class="text-4xl font-bold">50+</p>
          <p class="mt-2 text-brand-100">Armada Tersedia</p>
        </div>
        <div>
          <p class="text-4xl font-bold">100+</p>
          <p class="mt-2 text-brand-100">Driver Profesional</p>
        </div>
        <div>
          <p class="text-4xl font-bold">4.9</p>
          <p class="mt-2 text-brand-100">Rating Rata-rata</p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="rounded-2xl bg-white p-8 shadow-sm">
      <h2 class="text-2xl font-bold text-slate-900 mb-6 text-center">Hubungi Kami</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="font-semibold text-slate-900 mb-2">Alamat</h3>
          <p class="text-slate-600"><%= company.address %></p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900 mb-2">WhatsApp</h3>
          <p class="text-slate-600"><%= company.phone %></p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900 mb-2">Email</h3>
          <p class="text-slate-600"><%= company.email %></p>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900 mb-2">Jam Operasional</h3>
          <p class="text-slate-600">24/7 - Siap Melayani Anda</p>
        </div>
      </div>
    </section>
  </div>
</main>
</body>
</html>
