<%- include('partials/head') %>
<div class="flex justify-end px-4 py-3"><%- include('partials/language-switcher') %></div>
<%- include('partials/breadcrumb') %>
<div class="grid min-h-screen lg:grid-cols-2">
  <section class="relative hidden overflow-hidden bg-brand-900 lg:flex">
    <img
      src="https://images.unsplash.com/photo-1485291571150-772bcfc10da5?auto=format&fit=crop&w=1600&q=80"
      alt="Mobil rental"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="relative z-10 flex flex-col justify-end p-12 text-white">
      <p class="text-sm uppercase tracking-[0.25em] text-brand-100">Jalanin</p>
      <h1 class="mt-3 max-w-md text-4xl font-semibold leading-tight"><%= brand %></h1>
      <p class="mt-4 max-w-md text-brand-50/90">Login sekali. Admin ke dashboard internal, pelanggan ke beranda layanan rental, transfer, dan wisata.</p>
    </div>
  </section>

  <section class="flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-md">
      <p class="text-sm font-semibold text-brand-600"><%= brand %></p>
      <h2 class="mt-2 text-3xl font-semibold text-slate-900">Masuk ke akun</h2>
      <p class="mt-2 text-slate-500">Gunakan akun admin atau pelanggan untuk melihat tampilan yang berbeda.</p>

      <%- include('partials/flash') %>

      <form action="/login" method="post" class="mt-8 space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium">Email</label>
          <input name="email" type="email" required class="w-full rounded-xl border border-slate-200 px-4 py-3 outline-none ring-brand-500 focus:ring-2" placeholder="admin@rental.test" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium">Kata sandi</label>
          <input name="password" type="password" required class="w-full rounded-xl border border-slate-200 px-4 py-3 outline-none ring-brand-500 focus:ring-2" />
        </div>
        <button class="w-full rounded-xl bg-brand-600 py-3 font-semibold text-white hover:bg-brand-700">Masuk</button>
      </form>

      <p class="mt-5 text-sm text-slate-500">Belum punya akun pelanggan? <a href="/daftar" class="font-semibold text-brand-700">Daftar</a></p>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-4 text-sm">
        <p class="font-semibold text-slate-800">Akun contoh</p>
        <p class="mt-2 text-slate-600">Admin: <span class="font-medium">admin@rental.test</span> / admin123</p>
        <p class="text-slate-600">Pelanggan: <span class="font-medium">customer@rental.test</span> / customer123</p>
      </div>
    </div>
  </section>
</div>
</body>
</html>
