<%- include('../partials/head') %>
<%- include('../partials/site-header', { page: 'catalog' }) %>

<section class="bg-brand-700 pb-16 pt-10 text-white">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-sm text-brand-100">Sewa mobil lepas kunci</p>
    <h1 class="mt-2 text-3xl font-semibold md:text-4xl">Temukan mobil yang pas untuk perjalanan Anda</h1>
    <form action="/katalog" method="get" class="mt-8 grid gap-3 rounded-2xl bg-white p-4 text-slate-800 shadow-xl md:grid-cols-5">
      <select name="city" class="rounded-xl border border-slate-200 px-3 py-3">
        <option value="">Semua kota</option>
        <% cities.forEach((city) => { %>
          <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
        <% }) %>
      </select>
      <select name="type" class="rounded-xl border border-slate-200 px-3 py-3">
        <option value="">Semua tipe</option>
        <% ['MPV','SUV','Sedan','Hatchback'].forEach((type) => { %>
          <option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= type %></option>
        <% }) %>
      </select>
      <input name="startDate" type="date" value="<%= filters.startDate %>" class="rounded-xl border border-slate-200 px-3 py-3" />
      <input name="endDate" type="date" value="<%= filters.endDate %>" class="rounded-xl border border-slate-200 px-3 py-3" />
      <button class="rounded-xl bg-orange-500 px-4 py-3 font-semibold text-white hover:bg-orange-600">Tampilkan armada</button>
    </form>
  </div>
</section>

<main class="mx-auto max-w-6xl px-4 py-8">
  <%- include('../partials/flash') %>
  <p class="mb-4 text-lg font-semibold text-amber-600"><%= ratings.global.text %></p>
  <div class="mb-5 flex items-center justify-between">
    <h2 class="text-xl font-semibold text-slate-900"><%= vehicles.length %> mobil tersedia</h2>
  </div>

  <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    <% vehicles.forEach((vehicle) => { %>
      <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <img src="<%= vehicle.image %>" alt="<%= vehicle.name %>" class="h-44 w-full object-cover" />
        <div class="p-5">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold"><%= vehicle.name %></h3>
              <p class="text-sm text-slate-500"><%= vehicle.brand %> · <%= vehicle.city %></p>
            </div>
            <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700"><%= vehicle.type %></span>
          </div>
          <div class="mt-4 flex gap-4 text-sm text-slate-600">
            <span><%= vehicle.seats %> kursi</span>
            <span><%= vehicle.transmission %></span>
          </div>
          <div class="mt-5 flex items-end justify-between">
            <div>
              <p class="text-xs text-slate-400">Mulai dari</p>
              <p class="text-lg font-semibold text-slate-900"><%= rupiah(vehicle.pricePerDay) %><span class="text-sm font-normal text-slate-500">/hari</span></p>
            </div>
            <a href="/checkout?service=rental&vehicle=<%= encodeURIComponent(vehicle.name) %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">Booking Now</a>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

  <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-semibold">Tulis ulasan</h2>
    <% if (!canReview) { %>
      <p class="mt-3 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">Ulasan hanya dapat diberikan setelah Anda menyelesaikan perjalanan bersama kami.</p>
    <% } else { %>
    <form action="/ulasan" method="post" class="mt-4 grid gap-3 sm:grid-cols-2">
      <input name="nama_customer" required placeholder="Nama" value="<%= user ? user.name : '' %>" class="rounded-xl border border-slate-200 px-3 py-2" />
      <select name="category" required class="rounded-xl border border-slate-200 px-3 py-2">
        <option value="kendaraan">Kendaraan</option>
        <option value="layanan_sopir">Layanan/Sopir</option>
        <option value="situs_web">Situs Web</option>
      </select>
      <select name="vehicleName" class="rounded-xl border border-slate-200 px-3 py-2">
        <option value="">Kendaraan (jika ulasan armada)</option>
        <% vehicles.forEach((vehicle) => { %><option><%= vehicle.name %></option><% }) %>
      </select>
      <select name="rating" required class="rounded-xl border border-slate-200 px-3 py-2">
        <% [5,4,3,2,1].forEach((star) => { %><option value="<%= star %>"><%= star %> bintang</option><% }) %>
      </select>
      <textarea name="feedback" required rows="3" placeholder="Kritik dan saran" class="rounded-xl border border-slate-200 px-3 py-2 sm:col-span-2"></textarea>
      <button class="rounded-xl bg-brand-600 px-4 py-2 font-semibold text-white sm:w-fit">Kirim ulasan</button>
    </form>
    <% } %>
  </section>

  <% if (!vehicles.length) { %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center text-slate-500">
      Tidak ada mobil untuk filter ini. Coba ubah kota atau tipe.
    </div>
  <% } %>
</main>
<%- include('../partials/site-footer') %>
</body>
</html>
