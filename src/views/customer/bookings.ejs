<%- include('../partials/head') %>
<%- include('../partials/site-header', { page: 'bookings' }) %>
<main class="mx-auto max-w-4xl px-4 py-10">
  <h1 class="text-2xl font-semibold text-slate-900">Pesanan Saya</h1>
  <p class="mt-1 text-slate-500">Rental, airport transfer, dan paket wisata dari akun Anda.</p>
  <%- include('../partials/flash') %>

  <div class="mt-6 space-y-4">
    <% if (!orders.length) { %>
      <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-500">
        Belum ada pesanan. <a href="/#layanan" class="font-semibold text-brand-700">Isi formulir layanan</a>
      </div>
    <% } %>
    <% orders.forEach((order) => { %>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-wide text-slate-400"><%= serviceLabel(order.serviceType) %></p>
            <h2 class="text-lg font-semibold">
              <% if (order.serviceType === 'rental') { %>
                <%= order.details.vehicleName || order.details.rentalType %>
              <% } else if (order.serviceType === 'airport') { %>
                <%= order.details.serviceKind %>
              <% } else { %>
                <%= order.details.packageType %>
              <% } %>
            </h2>
            <p class="text-sm text-slate-500">
              <% if (order.serviceType === 'rental') { %>
                <%= order.details.rentalType %> · ambil <%= order.details.pickupDate %> · <%= order.details.durationDays %> hari
              <% } else if (order.serviceType === 'airport') { %>
                <%= order.details.flightNumber %> · <%= order.details.landingAt %> · <%= order.details.hotelLocation %>
              <% } else { %>
                <%= order.details.participantCount %> peserta
              <% } %>
            </p>
          </div>
          <span class="rounded-full px-3 py-1 text-xs font-medium <%= order.status === 'baru' ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700' %>">
            <%= orderStatusLabel(order.status) %>
          </span>
        </div>
        <% if (order.assignedEmployeeName) { %>
          <p class="mt-3 text-sm text-brand-700">Petugas: <%= order.assignedEmployeeName %></p>
        <% } %>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <a href="/voucher/<%= order.id %>" class="text-sm font-semibold text-brand-700">Lihat e-voucher</a>
          <% if (orderEditable(order)) { %>
            <a href="/pesanan/<%= order.id %>/ubah" class="text-sm font-semibold text-orange-600">Ubah tanggal &amp; jam</a>
          <% } else { %>
            <span class="text-sm font-semibold text-rose-700">Pesanan Tidak Dapat Diubah</span>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</main>
<%- include('../partials/site-footer') %>
</body>
</html>
