      <button class="gallery-filter-btn px-4 py-2 rounded-full bg-white text-slate-700 text-sm font-medium hover:bg-slate-200" data-filter="armada">Armada</button>
      <button class="gallery-filter-btn px-4 py-2 rounded-full bg-white text-slate-700 text-sm font-medium hover:bg-slate-200" data-filter="wisata">Wisata</button>
