      <div class="gallery-item rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" data-category="moment">
        <div class="aspect-square bg-gradient-to-br from-fuchsia-400 to-fuchsia-600 flex items-center justify-center">
          <svg class="h-16 w-16 text-white opacity-50" fill="currentColor" viewBox="0 0 24 24">
