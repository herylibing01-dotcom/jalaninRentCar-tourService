            <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
        </div>
        <div class="p-3">
          <p class="text-sm font-semibold text-slate-900">Toyota Avanza</p>
          <p class="text-xs text-slate-500">Armada Keluarga</p>
        </div>
      </div>

      <div class="gallery-item rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" data-category="armada">
        <div class="aspect-square bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center">
          <svg class="h-16 w-16 text-white opacity-50" fill="currentColor" viewBox="0 0 24 24">
