<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tugas Driver - Booking #<%= booking.id %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <!-- Header -->
  <header class="bg-blue-600 text-white py-4 px-4 shadow-lg">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-bold">Tugas Driver</h1>
          <p class="text-blue-100 text-sm">Booking #<%= booking.id %></p>
        </div>
        <div class="text-right">
          <p class="text-sm text-blue-100">Status</p>
          <p class="font-semibold"><%= booking.status %></p>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto p-4 space-y-4">
    <!-- Verifikasi Form -->
    <div id="verification-section" class="bg-white rounded-2xl shadow-md p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-4">Verifikasi Identitas</h2>
      <form id="verify-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Driver</label>
          <input type="text" id="driverName" name="driverName" required 
                 class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                 placeholder="Masukkan nama Anda">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Kode Booking</label>
          <input type="text" id="bookingCode" name="bookingCode" required 
                 class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                 placeholder="Masukkan kode booking">
        </div>
        <button type="submit" 
                class="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold hover:bg-blue-700 transition-colors">
          Verifikasi & Lihat Detail
        </button>
      </form>
      <div id="error-message" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"></div>
    </div>

    <!-- Booking Details (Hidden until verified) -->
    <div id="booking-details" class="hidden space-y-4">
      <!-- Vehicle Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">🚗</span>
          Informasi Kendaraan
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Nama Kendaraan</span>
            <span class="font-semibold text-gray-900"><%= booking.details.vehicleName %></span>
          </div>
          <% if (vehicle) { %>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Plat Nomor</span>
            <span class="font-semibold text-gray-900"><%= vehicle.plateNumber || 'N/A' %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tipe</span>
            <span class="font-semibold text-gray-900"><%= vehicle.type %></span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Kursi</span>
            <span class="font-semibold text-gray-900"><%= vehicle.seats %> Kursi</span>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Schedule Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📅</span>
          Jadwal Sewa
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tanggal Mulai</span>
            <span class="font-semibold text-gray-900"><%= booking.details.pickupDate %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Tanggal Selesai</span>
            <span class="font-semibold text-gray-900"><%= endDate %></span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Jam Jemput</span>
            <span class="font-semibold text-gray-900"><%= booking.details.pickupTime %></span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Durasi</span>
            <span class="font-semibold text-gray-900"><%= booking.details.durationDays %> Hari</span>
          </div>
        </div>
      </div>

      <!-- Location Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📍</span>
          Lokasi
        </h2>
        <div class="space-y-3">
          <div class="py-2 border-b border-gray-100">
            <span class="text-gray-600 block text-sm">Lokasi Penjemputan</span>
            <span class="font-semibold text-gray-900 block mt-1"><%= booking.details.pickupLocation %></span>
          </div>
          <div class="py-2">
            <span class="text-gray-600 block text-sm">Lokasi Pengantaran</span>
            <span class="font-semibold text-gray-900 block mt-1"><%= booking.details.dropoffLocation %></span>
          </div>
        </div>
      </div>

      <!-- Customer Info -->
      <div class="bg-white rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">👤</span>
          Informasi Pelanggan
        </h2>
        <div class="space-y-3">
          <div class="flex justify-between items-center py-2 border-b border-gray-100">
            <span class="text-gray-600">Nama</span>
            <span class="font-semibold text-gray-900"><%= booking.customerName %></span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span class="text-gray-600">Nomor HP</span>
            <a href="tel:<%= booking.customerPhone %>" 
               class="font-semibold text-blue-600 hover:text-blue-800">
              <%= booking.customerPhone %>
            </a>
          </div>
        </div>
      </div>

      <!-- Driver SOP -->
      <div class="bg-amber-50 rounded-2xl shadow-md p-6 border border-amber-200">
        <h2 class="text-lg font-bold text-amber-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📋</span>
          Tata Tertib Driver
        </h2>
        <ul class="space-y-2 text-amber-800 text-sm">
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Berpakaian rapi dan sopan saat bertugas</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Datang 15 menit sebelum waktu jemput yang dijadwalkan</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Dilarang merokok di dalam kendaraan</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Menjaga kebersihan kendaraan sepanjang perjalanan</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Bersikap ramah dan profesional kepada pelanggan</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Patuhi rute yang diminta pelanggan kecuali kondisi tidak memungkinkan</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-amber-600 mt-1">•</span>
            <span>Laporkan kendala segera ke admin jika terjadi masalah</span>
          </li>
        </ul>
      </div>

      <!-- Special Notes -->
      <% if (booking.details.specialRequest) { %>
      <div class="bg-blue-50 rounded-2xl shadow-md p-6 border border-blue-200">
        <h2 class="text-lg font-bold text-blue-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📝</span>
          Catatan Khusus Pesanan
        </h2>
        <p class="text-blue-800 text-sm whitespace-pre-wrap"><%= booking.details.specialRequest %></p>
      </div>
      <% } %>

      <!-- Contact Admin -->
      <div class="bg-gray-50 rounded-2xl shadow-md p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="text-2xl">📞</span>
          Butuh Bantuan?
        </h2>
        <p class="text-gray-600 text-sm mb-3">Hubungi admin jika ada pertanyaan atau kendala:</p>
        <a href="https://wa.me/6282266490281" target="_blank" 
           class="inline-flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-xl font-semibold hover:bg-green-700 transition-colors">
          <span>WhatsApp Admin</span>
        </a>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('verify-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const driverName = document.getElementById('driverName').value;
      const bookingCode = document.getElementById('bookingCode').value;
      const errorDiv = document.getElementById('error-message');
      
      try {
        const response = await fetch(`/task/driver-<%= booking.id %>-<%= booking.driverToken %>/verify`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ driverName, bookingCode }),
        });
        
        const result = await response.json();
        
        if (result.ok) {
          document.getElementById('verification-section').classList.add('hidden');
          document.getElementById('booking-details').classList.remove('hidden');
        } else {
          errorDiv.textContent = result.message;
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        errorDiv.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
        errorDiv.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
